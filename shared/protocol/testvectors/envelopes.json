{
  "description": "Canonical envelope test vectors for Family Beacon protocol v1. Canonical HERE (docs/FamilyBeacon-Testing.md -> Shared test vectors); consumed by beacon-protocol and, by checkout at a pinned ref, by Sund's beaconsim. Never vendor a second copy: two copies of a conformance corpus drift, and drift in the corpus hides drift in the implementations.",
  "envelope_version": 1,
  "expectations": {
    "accept": "decodes to a known type, from the authenticated sender",
    "unknown_type": "decodes, but this build does not know the type: ledger it by name, drop the body, acknowledge nothing",
    "reject": "refused at the boundary, with the reason tag given"
  },
  "reject_reasons": [
    "malformed",
    "unsupported_version",
    "empty_field",
    "body_not_object",
    "bad_timestamp",
    "sender_mismatch"
  ],
