# Copy to .env and edit. Compose reads .env automatically.
#
#   cp .env.example .env
#
# Everything here is deployment profile B (domain + WebPKI TLS). See
# ../../ARCHITECTURE.md → Deployment.

# The domain clients connect to. Must have an A/AAAA record pointing at this
# host. Devices are onboarded with the address:  sund+webpki://<this>
BEACON_DOMAIN=beacon.example.org

# Domain for the self-hosted ntfy (Android wake-up). Also needs its own
# A/AAAA record. Leave the ntfy service out entirely if you use ntfy.sh.
NTFY_DOMAIN=ntfy.example.org

# Contact address for the certificate authority (Let's Encrypt). Used for
# expiry warnings; not published.
ACME_EMAIL=you@example.org

# Which Sund image to run. Pin to a specific tag (e.g. :sha-<commit>) for
# reproducible deploys instead of :latest.
SUND_IMAGE=ghcr.io/mevoc/sund:latest
