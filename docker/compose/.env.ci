# Family Beacon — environment for the CI / local topology test.
#
# Used with compose.ci.yaml to stand up profile B without a domain, without
# ACME and without anything reachable from the internet:
#
#   docker compose --env-file docker/compose/.env.ci \
#     -f docker/compose/compose.yaml \
#     -f docker/compose/compose.ci.yaml up -d --wait
#
# This file exists because compose interpolates each file when it loads it,
# before merging: compose.yaml's ${BEACON_DOMAIN:?…} and ${ACME_EMAIL:?…} must
# therefore be set in the *environment*, and an `environment:` block in
# compose.ci.yaml cannot do it — that sets the container's env, which is too
# late. The network alias, ${NTFY_DOMAIN:-ntfy.invalid}, is the same mechanism
# and matters more: with nothing set here the alias would be `ntfy.invalid`
# while Caddy served `ntfy.test`, and the alias assertion — the whole reason
# the CI stack exists — would silently test nothing.
#
# Contains no secrets and is deliberately committed; see the exception in
# ../../.gitignore.

# Hostnames CI resolves to 127.0.0.1 (curl --resolve). `.test` is reserved by
# RFC 6761 and can never collide with a real domain.
BEACON_DOMAIN=beacon.test
NTFY_DOMAIN=ntfy.test

# Unused under `tls internal`, but the Caddyfile's global block references it,
# so it has to be something valid.
ACME_EMAIL=ci@beacon.test

# The one substantive override: Caddy's internal CA instead of Let's Encrypt.
# Empty in production — ../caddy/Caddyfile carries a {$CADDY_TLS} placeholder
# for exactly this, so CI exercises the real file rather than a copy.
CADDY_TLS=tls internal

# Pinned by commit, so a red build means this repo's change broke rather than
# that Sund moved underneath it. Bump deliberately. The scheduled canary
# overrides this with :latest through the shell environment, which takes
# precedence over an --env-file.
SUND_IMAGE=ghcr.io/mevoc/sund:sha-5843cdd75b290f1b33ea192fcdb8cdbf47898112
